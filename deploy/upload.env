# Settings for acrec_upload.sh (copy to /opt/acrec/upload.env).
ROOT=/data/acrec            # same as "root" in recorder.json
REMOTE=gdrive:acrec         # rclone remote:folder
KEEP_DAYS=7                 # delete local days this old once verified on Drive
GRACE_MIN=15                # minutes after midnight UTC before a day counts as closed
MIN_DRIVE_FREE_GB=5         # never fill Drive past this reserve

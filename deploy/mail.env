# Settings for acrec_mail.py (copy to /opt/acrec/mail.env, then edit).
ROOT=/data/acrec
MAIL_TO=you@example.com             # where reports go; comma-separate several
MAIL_FROM=sender@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=starttls                   # starttls | ssl | none
SMTP_USER=sender@gmail.com
SMTP_PASSWORD_FILE=/opt/acrec/smtp_password   # Gmail app password, chmod 600
STALE_MIN=5                         # heartbeat older than this = DOWN
HOST_LABEL=acrec-tokyo
